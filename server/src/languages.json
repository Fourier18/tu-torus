{
  "py": { "name": "Python", "monaco": "python", "run": { "engine": "pyodide" }},
  "js": { "name": "JavaScript", "monaco": "javascript", "run": { "engine": "toolchain", "bundledNode": true, "command": "node", "args": ["{file}"]}},
  "html": { "name": "a web page", "monaco": "html", "browserNative": true},
  "htm": { "monaco": "html", "browserNative": true},
  "svg": { "monaco": "xml", "browserNative": true},
  "css": { "monaco": "css", "runNote": "CSS styles a web page rather than running on its own. Put it in a <style> block inside an .html file (or link it from one), and Run will show the styled page." },
  "ts": { "name": "TypeScript", "monaco": "typescript", "run": { "engine": "toolchain", "bundledNode": true, "command": "node", "args": ["--experimental-transform-types", "--no-warnings", "{runners}/ts.mjs", "{file}"]}},
  "json": { "monaco": "json", "runNote": "JSON is data, not a program to run \u2014 a program (Python, JavaScript\u2026) can read it." },
  "md": { "monaco": "markdown", "runNote": "Markdown is text to read, not a program to run." },
  "rs": { "name": "Rust", "monaco": "rust", "run": { "engine": "toolchain", "command": "rustc", "compile": ["{file}", "-o", "{out}"], "exec": "{out}", "installName": "Rust", "installUrl": "https://www.rust-lang.org/tools/install" }},
  "go": { "name": "Go", "monaco": "go", "run": { "engine": "toolchain", "command": "go", "args": ["run", "{file}"], "installName": "Go", "installUrl": "https://go.dev/dl/" }},
  "java": { "name": "Java", "monaco": "java", "run": { "engine": "toolchain", "command": "javac", "compile": ["-d", "{dir}", "{file}"], "execCommand": "java", "execArgs": ["-cp", "{dir}", "{classname}"], "installName": "a Java JDK", "installUrl": "https://adoptium.net/" }},
  "rb": { "name": "Ruby", "monaco": "ruby", "run": { "engine": "toolchain", "bundledNode": true, "command": "node", "args": ["--no-warnings", "{runners}/ruby.mjs", "{file}"]}},
  "php": { "name": "PHP", "monaco": "php", "run": { "engine": "toolchain", "bundledNode": true, "command": "node", "args": ["--no-warnings", "{runners}/php.mjs", "{file}"]}},
  "c": { "name": "C", "monaco": "c", "run": { "engine": "toolchain", "command": "gcc", "compile": ["{file}", "-o", "{out}"], "exec": "{out}", "installName": "a C compiler (gcc, via MSYS2)", "installUrl": "https://www.msys2.org/" }},
  "cpp": { "name": "C++", "monaco": "cpp", "run": { "engine": "toolchain", "command": "g++", "compile": ["{file}", "-o", "{out}"], "exec": "{out}", "installName": "a C++ compiler (g++, via MSYS2)", "installUrl": "https://www.msys2.org/" }},
  "cs": { "name": "C#", "monaco": "csharp", "run": { "engine": "toolchain", "command": "dotnet", "args": ["run", "{file}"], "installName": "the .NET SDK, version 10 or later", "installUrl": "https://dotnet.microsoft.com/download", "minVersion": { "args": ["--version"], "major": 10}, "env": { "DOTNET_NOLOGO": "1", "DOTNET_CLI_TELEMETRY_OPTOUT": "1", "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "1" }}},
  "sh": { "name": "Bash", "monaco": "shell", "run": { "engine": "toolchain", "command": "bash", "args": ["{file}"], "installName": "Bash (comes with Git for Windows)", "installUrl": "https://git-scm.com/downloads" }},
  "pl": { "name": "Perl", "monaco": "perl", "run": { "engine": "toolchain", "bundledNode": true, "command": "node", "args": ["--no-warnings", "{runners}/perl.mjs", "{file}"]}},
  "lua": { "name": "Lua", "monaco": "lua", "run": { "engine": "toolchain", "bundledNode": true, "command": "node", "args": ["--no-warnings", "{runners}/lua.mjs", "{file}"]}},
  "bas": { "name": "BASIC", "monaco": "vb", "run": { "engine": "toolchain", "bundledNode": true, "command": "node", "args": ["--no-warnings", "{runners}/basic.cjs", "{file}"]}}
}
