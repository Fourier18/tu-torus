{
  "py": { "monaco": "python", "run": { "engine": "pyodide" } },
  "js": { "monaco": "javascript", "run": { "engine": "toolchain", "bundledNode": true, "command": "node", "args": ["{file}"] } },
  "html": { "monaco": "html", "browserNative": true },
  "htm": { "monaco": "html", "browserNative": true },
  "svg": { "monaco": "xml", "browserNative": true },
  "css": { "monaco": "css", "runNote": "CSS styles a web page rather than running on its own. Put it in a <style> block inside an .html file (or link it from one), and Run will show the styled page." },
  "ts": { "monaco": "typescript", "run": { "engine": "toolchain", "command": "npx", "args": ["-y", "tsx", "{file}"], "installName": "Node.js", "installUrl": "https://nodejs.org/en/download" } },
  "json": { "monaco": "json", "runNote": "JSON is data, not a program to run — a program (Python, JavaScript…) can read it." },
  "md": { "monaco": "markdown", "runNote": "Markdown is text to read, not a program to run." },
  "rs": { "monaco": "rust", "run": { "engine": "toolchain", "command": "rustc", "compile": ["{file}", "-o", "{out}"], "exec": "{out}", "installName": "Rust", "installUrl": "https://www.rust-lang.org/tools/install" } },
  "go": { "monaco": "go", "run": { "engine": "toolchain", "command": "go", "args": ["run", "{file}"], "installName": "Go", "installUrl": "https://go.dev/dl/" } },
  "java": { "monaco": "java", "run": { "engine": "toolchain", "command": "javac", "compile": ["-d", "{dir}", "{file}"], "execCommand": "java", "execArgs": ["-cp", "{dir}", "{classname}"], "installName": "a Java JDK", "installUrl": "https://adoptium.net/" } },
  "rb": { "monaco": "ruby", "run": { "engine": "toolchain", "command": "ruby", "args": ["{file}"], "installName": "Ruby", "installUrl": "https://rubyinstaller.org/" } },
  "php": { "monaco": "php", "run": { "engine": "toolchain", "command": "php", "args": ["{file}"], "installName": "PHP", "installUrl": "https://windows.php.net/download/" } },
  "c": { "monaco": "c", "run": { "engine": "toolchain", "command": "gcc", "compile": ["{file}", "-o", "{out}"], "exec": "{out}", "installName": "a C compiler (gcc, via MSYS2)", "installUrl": "https://www.msys2.org/" } },
  "cpp": { "monaco": "cpp", "run": { "engine": "toolchain", "command": "g++", "compile": ["{file}", "-o", "{out}"], "exec": "{out}", "installName": "a C++ compiler (g++, via MSYS2)", "installUrl": "https://www.msys2.org/" } },
  "cs": { "monaco": "csharp" },
  "sh": { "monaco": "shell", "run": { "engine": "toolchain", "command": "bash", "args": ["{file}"], "installName": "Bash (comes with Git for Windows)", "installUrl": "https://git-scm.com/downloads" } },
  "pl": { "monaco": "perl", "run": { "engine": "toolchain", "command": "perl", "args": ["{file}"], "installName": "Perl", "installUrl": "https://strawberryperl.com/" } }
}
