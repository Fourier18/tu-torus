{
  "py": { "monaco": "python", "run": { "engine": "pyodide" } },
  "js": { "monaco": "javascript", "run": { "engine": "toolchain", "command": "node", "args": ["{file}"] } },
  "html": { "monaco": "html", "browserNative": true },
  "htm": { "monaco": "html", "browserNative": true },
  "svg": { "monaco": "xml", "browserNative": true },
  "css": { "monaco": "css" },
  "ts": { "monaco": "typescript", "run": { "engine": "toolchain", "command": "npx", "args": ["-y", "tsx", "{file}"] } },
  "json": { "monaco": "json" },
  "md": { "monaco": "markdown" },
  "rs": { "monaco": "rust", "run": { "engine": "toolchain", "command": "rustc", "compile": ["{file}", "-o", "{out}"], "exec": "{out}" } },
  "go": { "monaco": "go", "run": { "engine": "toolchain", "command": "go", "args": ["run", "{file}"] } },
  "java": { "monaco": "java", "run": { "engine": "toolchain", "command": "javac", "compile": ["-d", "{dir}", "{file}"], "execCommand": "java", "execArgs": ["-cp", "{dir}", "{classname}"] } },
  "rb": { "monaco": "ruby", "run": { "engine": "toolchain", "command": "ruby", "args": ["{file}"] } },
  "php": { "monaco": "php", "run": { "engine": "toolchain", "command": "php", "args": ["{file}"] } },
  "c": { "monaco": "c", "run": { "engine": "toolchain", "command": "gcc", "compile": ["{file}", "-o", "{out}"], "exec": "{out}" } },
  "cpp": { "monaco": "cpp", "run": { "engine": "toolchain", "command": "g++", "compile": ["{file}", "-o", "{out}"], "exec": "{out}" } },
  "cs": { "monaco": "csharp" },
  "sh": { "monaco": "shell", "run": { "engine": "toolchain", "command": "bash", "args": ["{file}"] } },
  "pl": { "monaco": "perl", "run": { "engine": "toolchain", "command": "perl", "args": ["{file}"] } }
}
